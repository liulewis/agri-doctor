/* pages/article/article.wxss —— 文章详情 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.art-scroll {
  flex: 1;
  height: 0;
}

/* 标题区 */
.art-head {
  padding: 10rpx 6rpx 20rpx;
}

.ah-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.45;
  margin-top: 16rpx;
  letter-spacing: 0.5rpx;
}

.ah-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.ahm-a {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
}

.ahm-o {
  font-size: 23rpx;
  color: var(--sub);
  margin-left: 14rpx;
  background: #eef3f0;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.ah-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.ah-sub .muted {
  font-size: 22rpx;
  margin-right: 10rpx;
}

/* 摘要 */
.art-abs {
  background: #f4faf6;
  border-radius: 14rpx;
  padding: 22rpx;
  display: flex;
  align-items: flex-start;
}

.aa-tag {
  font-size: 22rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  line-height: 1.6;
}

.aa-text {
  flex: 1;
  font-size: 25rpx;
  color: #3d5c4a;
  line-height: 1.75;
}

/* 阅读设置条 */
.art-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 0 8rpx;
  padding: 14rpx 18rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: var(--shadow);
}

.ab-left {
  display: flex;
  align-items: center;
}

.ab-label {
  font-size: 23rpx;
  color: var(--sub);
  margin-right: 14rpx;
}

.ab-size {
  font-size: 23rpx;
  color: var(--sub);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
}

.ab-size.on {
  color: var(--primary);
  border-color: var(--primary);
  background: rgba(18, 168, 157, 0.08);
}

.ab-outline {
  font-size: 24rpx;
  color: var(--primary);
}

/* 正文 */
.art-body {
  padding: 12rpx 4rpx 8rpx;
}

.fs-sm .p-text,
.fs-sm .pp-text {
  font-size: 26rpx;
}

.fs-md .p-text,
.fs-md .pp-text {
  font-size: 29rpx;
}

.fs-lg .p-text,
.fs-lg .pp-text {
  font-size: 33rpx;
}

.p-text {
  color: #2b3a31;
  line-height: 1.95;
  margin: 26rpx 0;
  text-align: justify;
}

.pt-no {
  display: inline-block;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(18, 168, 157, 0.12);
  color: var(--primary);
  font-size: 20rpx;
  margin-right: 12rpx;
  vertical-align: 4rpx;
}

.p-head {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin: 34rpx 0 14rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid var(--primary);
  line-height: 1.5;
}

.p-point {
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0;
}

.pp-dot {
  color: var(--primary);
  margin-right: 12rpx;
  font-size: 30rpx;
  line-height: 1.8;
}

.pp-text {
  flex: 1;
  color: #3d5c4a;
  line-height: 1.8;
}

/* 标签 */
.art-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 0 6rpx;
}

.art-tags .tag {
  margin: 0 14rpx 12rpx 0;
}

/* 作者卡片 */
.auth-card {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
}

.ac-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.ac-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.ac-org {
  font-size: 23rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

.ac-btn {
  padding: 0 30rpx;
  height: 62rpx;
  line-height: 62rpx;
  font-size: 25rpx;
}

/* 底部操作 */
.bb-act {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bb-act.on .ba-ico,
.bb-act.on .ba-t {
  color: #fa9d3b;
}

.ba-ico {
  font-size: 34rpx;
  line-height: 1.1;
  color: var(--sub);
}

.ba-t {
  font-size: 20rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

/* 目录抽屉 */
.ol-scroll {
  max-height: 640rpx;
}

.ol-item {
  display: flex;
  align-items: center;
  padding: 22rpx 6rpx;
  border-bottom: 1rpx solid var(--line);
}

.ol-item:last-child {
  border-bottom: none;
}

.oi-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(18, 168, 157, 0.1);
  color: var(--primary);
  font-size: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.oi-t {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
}

.em-btn {
  margin-top: 26rpx;
  padding: 0 54rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 27rpx;
}
