.container { padding: 24rpx; }

/* ===== 步骤 1：取图区 ===== */
.shot { margin-top: 24rpx; padding: 0; overflow: hidden; }
.shot-box {
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(150deg, #f3faf5, #e9f6ee);
  border: 4rpx dashed #b7e3c8;
  border-radius: var(--radius);
  transition: transform .15s ease;
}
.shot-box:active { transform: scale(.985); }
.shot-ico { font-size: 90rpx; }
.shot-t1 { font-size: 32rpx; font-weight: 700; color: var(--primary-dark); }
.shot-t2 { font-size: 23rpx; color: var(--muted); }

.preview { position: relative; }
.pv-img { width: 100%; height: 420rpx; display: block; }
.pv-emoji {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 180rpx;
  background: linear-gradient(150deg, #f3faf5, #dff0e6);
}
.pv-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  background: var(--surface);
}
.pv-name { font-size: 26rpx; color: var(--text-2); flex: 1; min-width: 0; }
.pv-del {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* ===== 示例样本 ===== */
.sample-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.sp-card {
  width: calc(33.33% - 12rpx);
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 20rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 3rpx solid transparent;
  transition: all .18s ease;
}
.sp-card:active { transform: scale(.95); }
.sp-card.active {
  border-color: var(--primary);
  background: var(--primary-soft);
}
.sp-emoji { font-size: 48rpx; }
.sp-name { font-size: 23rpx; color: var(--text); font-weight: 600; margin-top: 8rpx; }
.sp-hint { font-size: 20rpx; color: var(--muted); margin-top: 4rpx; }

/* ===== 表单 ===== */
.form { margin-top: 24rpx; }
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child { border-bottom: none; }
.field.colf { flex-direction: column; align-items: stretch; }
.label { font-size: 28rpx; font-weight: 600; color: var(--text); }
.field.colf .label { margin-bottom: 14rpx; }
.picker { color: var(--primary-dark); font-size: 28rpx; }

/* ===== 拍摄要点 ===== */
.tips { margin-top: 24rpx; background: var(--surface-2); box-shadow: none; }
.tips-title { font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: 6rpx; }

/* ===== 步骤 2：识别中 ===== */
.ing {
  margin-top: 80rpx;
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
}
.ing-emoji {
  font-size: 110rpx;
  animation: bob 1.4s ease-in-out infinite;
}
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
.ing-title { font-size: 34rpx; font-weight: 700; margin-top: 20rpx; }
.ing-text { font-size: 25rpx; color: var(--muted); margin-top: 10rpx; }
.ing-pct { font-size: 24rpx; color: var(--primary-dark); font-weight: 700; margin-top: 12rpx; }
.ing-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}
.is {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: var(--muted);
}
.is-d {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #dfe7e2;
}
.is.done { color: var(--primary-dark); font-weight: 600; }
.is.done .is-d { background: var(--primary); box-shadow: 0 0 0 6rpx rgba(18, 168, 157, .16); }

/* ===== 步骤 3：结果 ===== */
.res-main { margin-top: 24rpx; }
.res-head { display: flex; gap: 24rpx; align-items: flex-start; }
.res-emoji {
  width: 116rpx;
  height: 116rpx;
  border-radius: 26rpx;
  background: linear-gradient(140deg, #eef8f1, #dbf0e4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  flex-shrink: 0;
}
.res-hinfo { flex: 1; min-width: 0; }
.res-name { font-size: 38rpx; font-weight: 800; color: var(--text); }
.res-alias { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.res-badges { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }

.conf-box {
  margin-top: 26rpx;
  background: var(--surface-2);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
}
.conf-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14rpx; }
.conf-lab { font-size: 26rpx; color: var(--text-2); }
.conf-val { font-size: 40rpx; font-weight: 800; }
.conf-val.lv-high { color: var(--primary); }
.conf-val.lv-mid { color: #d9822b; }
.conf-val.lv-low { color: var(--danger); }
.conf-note { font-size: 21rpx; color: var(--muted); margin-top: 12rpx; }

.res-summary {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
  padding: 20rpx 22rpx;
}

/* 用药警示 */
.med-warn {
  margin-top: 18rpx;
  background: #fff5ef;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #c85c22;
}

/* 相似对象 */
.sim-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sim-row:last-of-type { border-bottom: none; }
.sim-row:active { background: var(--surface-2); }
.sim-emoji {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.sim-info { flex: 1; min-width: 0; }
.sim-name { font-size: 27rpx; color: var(--text); font-weight: 600; }
.sim-crop { font-size: 21rpx; color: var(--muted); margin-top: 4rpx; }
.sim-bar { width: 180rpx; flex-shrink: 0; }
.sim-pct { font-size: 20rpx; color: var(--muted); display: block; text-align: right; margin-top: 6rpx; }
.sim-note { font-size: 21rpx; color: var(--muted); margin-top: 14rpx; }

/* ===== 识别记录弹层 ===== */
.hist-scroll { max-height: 700rpx; }
.hist-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.hist-row:last-child { border-bottom: none; }
.hist-emoji {
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.hist-info { flex: 1; min-width: 0; }
.hist-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.hist-sub { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.hist-right { text-align: right; flex-shrink: 0; }
.hist-conf { display: block; font-size: 22rpx; color: var(--primary-dark); margin-top: 8rpx; font-weight: 600; }
