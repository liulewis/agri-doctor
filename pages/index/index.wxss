.container { padding: 24rpx; }

/* ===== 顶部英雄区 ===== */
.hero {
  background: linear-gradient(140deg, #12a89d 0%, #4ec4ba 55%, #46d183 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 34rpx 32rpx 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 168, 157, .26);
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: "";
  position: absolute;
  right: -80rpx; top: -90rpx;
  width: 260rpx; height: 260rpx;
  background: rgba(255, 255, 255, .12);
  border-radius: 50%;
}
.hero::before {
  content: "";
  position: absolute;
  left: -60rpx; bottom: -110rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255, 255, 255, .08);
  border-radius: 50%;
}
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.hero-hello { font-size: 26rpx; opacity: .92; }
.hero-date { font-size: 23rpx; opacity: .8; }
.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-top: 16rpx;
  position: relative;
}
.hero-sub { font-size: 24rpx; opacity: .9; margin-top: 8rpx; position: relative; }

/* 拍照识别大按钮 */
.cam-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, .96);
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-top: 28rpx;
  position: relative;
  box-shadow: 0 10rpx 24rpx rgba(4, 90, 45, .16);
  transition: transform .15s ease;
}
.cam-btn:active { transform: scale(.975); }
.cam-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e6f7f6, #d3f2e0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex-shrink: 0;
}
.cam-txt { flex: 1; min-width: 0; }
.cam-t1 { font-size: 32rpx; font-weight: 700; color: var(--text); }
.cam-t2 { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }
.cam-go { font-size: 44rpx; color: var(--primary); }

/* 英雄区快捷三格 */
.hero-quick {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, .18);
  border-radius: 18rpx;
  margin-top: 22rpx;
  padding: 16rpx 0;
  position: relative;
}
.hq {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  transition: transform .15s ease;
}
.hq:active { transform: scale(.93); }
.hq-ico { font-size: 34rpx; }
.hq-t { font-size: 23rpx; opacity: .95; }
.hq-div { width: 1rpx; height: 52rpx; background: rgba(255, 255, 255, .28); }

/* ===== 公告 ===== */
.notice-card { margin-top: 24rpx; padding: 0 24rpx; }
.notice-swiper { height: 96rpx; }
.notice-row {
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
}
.nt-ico { font-size: 30rpx; }
.nt-title {
  color: var(--primary-dark);
  font-weight: 700;
  flex-shrink: 0;
  background: var(--primary-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.nt-text { color: var(--text-2); flex: 1; min-width: 0; }

/* ===== 概览卡 ===== */
.ov-card { margin-top: 24rpx; }
.ov-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.ov-more { font-size: 24rpx; color: var(--muted); position: relative; padding-right: 14rpx; }
.ov-red {
  position: absolute;
  right: 0; top: 2rpx;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--expense);
}
.ov-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
  background: #fff5ef;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #c85c22;
}
.ovt-ico { font-size: 28rpx; }
.ov-tip .ovt-go { margin-left: auto; font-size: 32rpx; color: #e08a52; }

/* ===== 章节标题右侧更多 ===== */
.st-more {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

/* ===== 热门病害横滑 ===== */
.hot-scroll { width: 100%; white-space: nowrap; }
.hot-wrap { display: inline-flex; gap: 20rpx; padding: 4rpx 2rpx 12rpx; }
.hot-card {
  width: 236rpx;
  background: var(--surface);
  border-radius: var(--radius);
  padding: 24rpx 22rpx;
  box-shadow: var(--shadow-sm);
  display: inline-flex;
  flex-direction: column;
  gap: 8rpx;
  transition: transform .15s ease;
  position: relative;
}
.hot-card:active { transform: scale(.96); }
.hot-emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f1f9f3, #e2f4e9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.hot-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.hot-crop { font-size: 22rpx; color: var(--muted); }
.hot-foot { display: flex; align-items: center; gap: 10rpx; margin-top: 4rpx; }
.hot-views { font-size: 20rpx; color: #bcc7c0; margin-top: 2rpx; }

/* ===== 知识库入口宫格 ===== */
.kb-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.kb-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--radius);
  padding: 26rpx 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform .15s ease;
}
.kb-card:active { transform: scale(.96); }
.kb-ico { font-size: 42rpx; }
.kb-name { font-size: 28rpx; font-weight: 700; color: var(--text); margin-top: 10rpx; }
.kb-desc { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

/* ===== 专家行 ===== */
.ex-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background .15s ease;
}
.ex-row:last-child { border-bottom: none; }
.ex-row:active { background: var(--surface-2); }
.ex-info { flex: 1; min-width: 0; }
.ex-line1 { display: flex; align-items: center; gap: 10rpx; }
.ex-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.ex-title { font-size: 21rpx; color: var(--primary-dark); background: var(--primary-soft); padding: 3rpx 12rpx; border-radius: 6rpx; }
.ex-online { font-size: 21rpx; color: var(--muted); }
.ex-field { font-size: 24rpx; color: var(--text-2); margin-top: 8rpx; }
.ex-meta { display: flex; gap: 20rpx; margin-top: 8rpx; }
.ex-score { font-size: 22rpx; color: #d9822b; }
.ex-served { font-size: 22rpx; color: var(--muted); }

/* ===== 服务说明 ===== */
.svc { margin-top: 24rpx; background: var(--primary-soft); box-shadow: none; }
.svc-title { font-size: 28rpx; font-weight: 700; color: var(--primary-dark); margin-bottom: 14rpx; }
.svc-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 24rpx;
  color: #3b5a48;
  line-height: 1.6;
  padding: 8rpx 0;
}
.svc-n {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.fab { font-size: 46rpx; }
